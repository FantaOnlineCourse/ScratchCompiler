# 本檔所有值都會進入公開的前端產物——只能放可公開的東西。
# 主平台 scripts/gen-editor-keys.mjs 產生的公鑰（單行，換行以 \n 表示）
VITE_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# 允許嵌入本編輯器的主平台來源（逗號分隔）。本機：主平台 3000、harness 5174
VITE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174
# 本應用原始碼的公開倉庫網址（AGPL v3 義務，FR-EDT-014）
VITE_SOURCE_URL=https://github.com/REPLACE-ME/block-editor-host
